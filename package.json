{
  "name": "jdoc",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "db:generate": "pnpm --filter @jdoc/database generate",
    "db:migrate": "pnpm --filter @jdoc/database migrate",
    "db:seed": "pnpm --filter @jdoc/database seed",
    "admin:create": "pnpm --filter @jdoc/database admin:create",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}

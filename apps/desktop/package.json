    "@types/node": "^22.10.2",
    "electron-builder": "^24.13.3",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
